{
  "name": "yearafter",
  "private": true,
  "version": "0.0.1",
  "description": "YearAfter \u2014 mobile life-simulation game. Monorepo root.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "validate:content": "node tools/content-validator/validate.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm validate:content",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml}\"",
    "mobile": "pnpm --filter @yearafter/mobile start",
    "mobile:clear": "pnpm --filter @yearafter/mobile exec expo start -c"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
